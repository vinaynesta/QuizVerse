target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
# application*.properties are tracked and must only reference env vars (${...}).
# Put personal overrides or real credentials in application-local.properties, which is never committed.
src/main/resources/application-local.properties
.env

