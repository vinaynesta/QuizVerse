# Copy to .env and fill in real values. .env is gitignored and loaded automatically
# by Spring Boot (spring.config.import in application.properties). Never commit .env.
# In production (Railway) set these as service variables instead.

# --- Production database (only used with SPRING_PROFILES_ACTIVE=prod) ---
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# --- App ---
QUIZVERSE_ADMIN_USERNAMES=
QUIZVERSE_PUBLIC_URL=
# Long random string, e.g. output of: openssl rand -base64 48
QUIZVERSE_SIGNING_KEY=

# --- Google sign-in (client id is public, not a secret) ---
GOOGLE_CLIENT_ID=

# --- Email via Resend ---
RESEND_API_KEY=
MAIL_FROM=
